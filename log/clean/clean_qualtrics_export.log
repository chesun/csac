>     | strpos(gender_other, "TWO SPIRIT")!=0
>     | strpos(gender_other, "AGENDER")!=0
>     | strpos(gender_other, "GENDERQUEER")!=0
>     | strpos(gender_other, "GENDER QUEER")!=0
>     ;
