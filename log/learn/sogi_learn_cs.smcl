{smcl}
{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}/home/research/ca_ed_lab/projects/csac_survey2023/log/learn/sogi_learn_cs.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res}27 Sep 2023, 16:23:08
{txt}
{com}. 
. graph drop _all
{txt}
{com}. set more off
{txt}
{com}. set varabbrev off
{txt}
{com}. set graphics off
{txt}
{com}. set scheme s1color
{txt}
{com}. set seed 1984
{txt}
{com}. 
. local date1 = c(current_date)
{txt}
{com}. local time1 = c(current_time)
{txt}
{com}. 
. /* ssc install ngram, replace 
> ssc install txttool, replace  */
. 
. /* net install "http://researchbtn.com/stata/110/wordfreq.pkg"
> net install "http://researchbtn.com/stata/110/wordcloud.pkg" */
. 
. * Load fully cleaned data
. use $csacclndatadir/csac_hs_senior_2023_clean, clear 
{txt}(Fully cleaned CSAC 2023 HS senior survey data)

{com}. 
. 
. 
. // create a var that generates clean tags for the free text response for gender
. gen gender_other_tag = gender_other_raw
{txt}(11,351 missing values generated)

{com}. replace gender_other_tag = "NONSERIOUS" if gender_other_clean=="CISGENDER/OTHER"
{txt}(16 real changes made)

{com}. // clean the leftover nonserious responses 
. 
. #delimit ;
{txt}delimiter now ;
{com}. replace gender_other_tag = "NONSERIOUS" if strpos(gender_other_raw, "DON'T BELIEVE IN THIS")!=0 
>     | strpos(gender_other_raw, "NO ONE CAN CHANGE") !=0 
>     | strpos(gender_other_raw, "STRAIGHT WOMAN")!=0
>     | strpos(gender_other_raw, "MENTALLY ILL")!=0
>     ;
{txt}(3 real changes made)

{com}. // consolidate gender fluid ;
> replace gender_other_tag = "GENDERFLUID"
>     if strpos(gender_other_raw, "GENDERFLUID")!=0
>     | strpos(gender_other_raw, "GENDER FLUID")!=0
>     ;
{txt}(7 real changes made)

{com}. // consolidate unsure ;
> /* replace gender_other_tag = "UNSURE/QUESTIONING"
>     if strpos(gender_other_raw, "UNSURE")!=0
>     | strpos(gender_other_raw, "UNKNOWN")!=0
>     | strpos(gender_other_raw, "UNCERTAIN")!=0
>     | strpos(gender_other_raw, "QUESTIONING")!=0
>     | strpos(gender_other_raw, "NOT SURE")!=0
>     | strpos(gender_other_raw, "CONFUSED")!=0
>     ; */
> 
> #delimit cr
{txt}delimiter now cr
{com}. 
. 
. gen gender_tag = gender_raw 
{txt}(3,478 missing values generated)

{com}. replace gender_tag = gender_other_tag if gender_raw=="OTHER"
{txt}variable {bf}{res}gender_tag{sf}{txt} was {bf}{res}str17{sf}{txt} now {bf}{res}str183{sf}
{txt}(95 real changes made)

{com}. // replace nonserious responses with assigned gender at birth
. replace gender_tag = agab if gender_other_tag=="NONSERIOUS"
{txt}(19 real changes made)

{com}. replace gender_tag = "TRANS WOMAN" if gender_trans_binary==1 & gender_woman==1
{txt}(22 real changes made)

{com}. replace gender_tag = "TRANS MAN" if gender_trans_binary==1 & gender_man==1
{txt}(65 real changes made)

