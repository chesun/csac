. *================*
. * Visualization  *
. *================*
. 
. if `do_plot' == 1{
. 
. * Relabel Crosstab Variables to include counts
. foreach var in $xtab{
  2.         qui levelsof `var', local(vals)
  3.         foreach val in `vals'{
  4.                 local oldlbl: label (`var') `val'
  5.                 qui count if `var' == `val'
  6.                 label define new_`var'_lbl `val' "`oldlbl' (N=`r(N)')", add
  7.         }
  8. label val `var' new_`var'_lbl
  9. }
. 
. 
. 
. * Stacked Bar Graphs
. foreach var in $hsexp $plans $nfaworries {
  2. * Stacked Bar Graph For Overall
.         #delimit;
delimiter now ;
.         graph hbar, over(`var', label(labsize(small))) asyvars stack 
>                 percentages missing
>                 title("$`var'", span size(medium))
>                 ;
  3.                 // note: percentages option make the graph shows the within percentages
>         #delimit cr 
delimiter now cr
.         graph export "$csacprojdir/fig/learn/brief/`var'.png", replace
  4. 
.         * Stacked Bar Graph By Crosstab Vars
.         foreach cat in $xtab{
  5.                 if "`var'" != "`cat'"{ // omit against itself
  6.                 #delimit;
delimiter now ;
.                 graph hbar, over(`var', label(labsize(small))) asyvars stack 
>                         over(`cat', label(labsize(small))) 
>                         percentages missing
>                         title("$`var'", span size(medium))
>                         ;
  7.                         // note: percentages option make the graph shows the within percentages
>                 #delimit cr 
delimiter now cr
.                 graph export "$csacprojdir/fig/learn/brief/`var'X`cat'.png", replace
  8.                 }
  9.         }
 10. }
. 
