. * Relabel Crosstab Variables to include counts
. foreach var in $xtab{
  2.         qui levelsof `var', local(vals)
  3.         foreach val in `vals'{
  4.                 local oldlbl: label (`var') `val'
  5.                 qui count if `var' == `val'
  6.                 label define new_`var'_lbl `val' "`oldlbl' (N=`r(N)')", ad
> d
  7.         }
  8. label val `var' new_`var'_lbl
  9. }
. 
