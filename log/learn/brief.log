. * Gender & Race
. foreach cat in gender_brief_main race_brief parent_edu_brief { // foreach crosstab variable
  2.         di ""
  3.         di "$`cat'"
  4.         qui levelsof `cat', local(vals)
  5.         foreach val in `vals'{ // each subsample
  6.         eststo clear
  7.         foreach y in $nfaworries{
  8.                 qui eststo: qui reg v_`y' if `cat' == `val'  // estimate the share of very worried
  9.         }
 10.         local lab: label(`cat') `val' // row name
 11.         esttab, nostar not b(a3) coeflabels(_cons "`lab'") nomtitles varwidth(20) nonum nodep noline // each subsample is a row
