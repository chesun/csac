. // recode start date and end date into stata date time format
. foreach var in startdate enddate recordeddate {c -(}
{txt}  2{com}.     gen `var'_temp = Clock(`var', "YMD hms")
{txt}  3{com}.     format %tC `var'_temp
{txt}  4{com}.     drop `var'
{txt}  5{com}.     rename `var'_temp `var'
{txt}  6{com}. {c )-}
{res}{txt}
{com}. order startdate enddate recordeddate
{txt}
{com}. 
