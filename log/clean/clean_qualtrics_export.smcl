. 
. // import csv data, variable names in first row, discard row 2 and 3 (question names and import tags, not data)
. import delimited $csacdatadir/raw/csac_hs_senior_2023_export_07_05_2023.csv, varnames(1) rowrange(4:) clear
{res}{txt}(encoding automatically selected: UTF-8)
{text}(249 vars, 19,238 obs)

{com}. 
. // drop unused variables
. drop status recipientfirstname recipientlastname recipientemail externalreference distributionchannel userlanguage
{txt}
{com}. drop *firstclick *lastclick *clickcount
{txt}
{com}. 
. //---------------------------------------------------------------------------
. // create identifier crosswalk
. //---------------------------------------------------------------------------
. 
. // minimal cleaning to produce crosswalk: rename variables and label them
. rename responseid id
{res}{txt}
{com}. label var id "unique response id"
{txt}
{com}. 
. rename locationlatitude latitude
{res}{txt}
{com}. rename locationlongitude longitude
{res}{txt}
{com}. 
. rename q5 email
{res}{txt}
{com}. label var email "email address which received survey link"
{txt}
{com}. 
. rename q86 email_fall
{res}{txt}
{com}. label var email_fall "email to contact in the fall"
{txt}
{com}. 
. // delete observations with missing email
. drop if email==""
{txt}(7,797 observations deleted)

{com}. 
. // preserve dataset
. preserve
{txt}
{com}. 
. keep id ipaddress latitude longitude email email_fall
{txt}
{com}. 
. label data "Identifying information crosswalk for CSAC HS Senior survey 2023"
{txt}
{com}. 
. compress
  {txt}variable {bf}{res}ipaddress{sf}{txt} was {bf}{res}str24{sf}{txt} now {bf}{res}str15{sf}
  {txt}variable {bf}{res}id{sf}{txt} was {bf}{res}str24{sf}{txt} now {bf}{res}str17{sf}
  {txt}variable {bf}{res}latitude{sf}{txt} was {bf}{res}str31{sf}{txt} now {bf}{res}str8{sf}
  {txt}variable {bf}{res}longitude{sf}{txt} was {bf}{res}str32{sf}{txt} now {bf}{res}str9{sf}
  {txt}variable {bf}{res}email{sf}{txt} was {bf}{res}str67{sf}{txt} now {bf}{res}str48{sf}
  {txt}variable {bf}{res}email_fall{sf}{txt} was {bf}{res}str62{sf}{txt} now {bf}{res}str38{sf}
