. * Stacked Bar Graphs
. foreach var in $hsexp $plans $nfaworries {
  2. * Stacked Bar Graph For Overall
.         #delimit;
delimiter now ;
.         graph hbar, over(`var', label(labsize(small))) asyvars stack 
>                 percentages missing
>                 title("$`var'", span size(medium))
>                 ;
  3.                 // note: percentages option make the graph shows the withi
> n percentages
>         #delimit cr 
delimiter now cr
.         graph export "$csacprojdir/fig/learn/brief/`var'.png", replace
  4. 
.         * Stacked Bar Graph By Crosstab Vars
.         foreach cat in $xtab{
  5.                 if "`var'" != "`cat'"{ // omit against itself
  6.                 #delimit;
delimiter now ;
.                 graph hbar, over(`var', label(labsize(small))) asyvars stack 
>                         over(`cat', label(labsize(small))) 
>                         percentages missing
>                         title("$`var'", span size(medium))
>                         ;
  7.                         // note: percentages option make the graph shows t
> he within percentages
>                 #delimit cr 
delimiter now cr
.                 graph export "$csacprojdir/fig/learn/brief/`var'X`cat'.png", 
> replace
  8.                 }
  9.         }
