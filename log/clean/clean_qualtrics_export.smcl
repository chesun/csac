{com}. 
. // first clean the gender_other and so_other text responses 
. foreach v in gender_other so_other {c -(}
{txt}  2{com}.     // convert to upper case
.     replace `v' = strupper(`v')
{txt}  3{com}.     // collapse internal multiple blanks to one blank 
.     replace `v' = stritrim(`v')
{txt}  4{com}.     // remove leading and trailing blanks
.     replace `v' = strtrim(`v')
{txt}  5{com}.     // remove dashes "-"
.     replace `v' = subinstr(`v', "-", "", .)
{txt}  6{com}. {c )-} 
